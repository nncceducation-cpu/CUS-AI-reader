{
  "model_id": "cus-multitask-example",
  "version": "0.0.0",
  "onnx_file": "cus-multitask-example.onnx",
  "input_size": [
    512,
    512
  ],
  "batch_size": 16,
  "plane_confidence_threshold": 0.7,
  "plane_margin": 0.1,
  "decision_margin": 0.05,
  "labels": [
    "adequate_plane",
    "plane_coronal",
    "plane_sagittal",
    "plane_posterior_fossa",
    "plane_other",
    "left_germinal_matrix_hemorrhage",
    "right_germinal_matrix_hemorrhage",
    "left_intraventricular_blood",
    "right_intraventricular_blood",
    "left_ventricular_distension",
    "right_ventricular_distension",
    "left_ahw_above_6_mm",
    "right_ahw_above_6_mm",
    "left_ahw_above_10_mm",
    "right_ahw_above_10_mm",
    "left_focal_periventricular_echogenicity",
    "right_focal_periventricular_echogenicity",
    "left_echogenicity_brighter_than_choroid",
    "right_echogenicity_brighter_than_choroid",
    "left_porencephalic_cyst",
    "right_porencephalic_cyst",
    "wmi_none",
    "wmi_pve_under_7_days",
    "wmi_grade_1",
    "wmi_grade_2",
    "wmi_grade_3",
    "wmi_grade_4",
    "cbh_none",
    "cbh_punctate",
    "cbh_limited",
    "cbh_large",
    "vi_above_97th",
    "vi_above_97th_plus_4_mm",
    "left_hemorrhage_present",
    "right_hemorrhage_present",
    "left_multiple_evolved_pvhi_cysts",
    "right_multiple_evolved_pvhi_cysts"
  ],
  "thresholds": {
    "adequate_plane": 0.8,
    "left_germinal_matrix_hemorrhage": 0.5,
    "right_germinal_matrix_hemorrhage": 0.5,
    "left_intraventricular_blood": 0.5,
    "right_intraventricular_blood": 0.5,
    "left_focal_periventricular_echogenicity": 0.5,
    "right_focal_periventricular_echogenicity": 0.5
  },
  "validated": false,
  "intended_use": "Research only. Example contract, not a clinical model. Replace calibration and thresholds with values fitted by scripts/fit_operating_point.py on your own labelled studies before any reporting use.",
  "aggregation_mode": "persistence",
  "aggregation": {
    "min_frames": 2,
    "min_run": 3,
    "persistence_fraction": 0.02,
    "prevalence_threshold": 0.5,
    "use_quality_weights": true,
    "require_two_planes": true,
    "label_plane_scope": {
      "cbh_": [
        "posterior_fossa"
      ],
      "vi_": [
        "coronal"
      ],
      "left_ahw_": [
        "coronal"
      ],
      "right_ahw_": [
        "coronal"
      ],
      "wmi_": [
        "coronal",
        "sagittal"
      ]
    }
  },
  "softmax_groups": [
    "wmi",
    "cerebellar_hemorrhage"
  ],
  "calibration": {
    "temperature": 1.0,
    "per_label": {
      "left_germinal_matrix_hemorrhage": {
        "method": "platt",
        "slope": 1.0,
        "intercept": 0.0
      },
      "right_germinal_matrix_hemorrhage": {
        "method": "platt",
        "slope": 1.0,
        "intercept": 0.0
      }
    }
  }
}
